#!/usr/bin/env python3
"""Aviary stand-in for the lab: public video/door status, an admin console, a door control API.

Mirrors the *shape* of the real scenario app (three ports, default credentials, a control token,
runs as root) so credential rotation and privilege-drop fixes can be tested. Standard library only.
Credentials come from the environment (/etc/birdcage.env); the defaults are deliberately weak.
"""
import hashlib
import hmac
import json
import os
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs, urlparse

STATE_DIR = os.environ.get('BIRDCAGE_STATE_DIR', '/var/lib/birdcage')
STATE_FILE = os.path.join(STATE_DIR, 'door.json')
USERS = {
    'admin': os.environ.get('BIRDCAGE_ADMIN_PASSWORD', 'Aviary-Default-1!'),
    'operator': os.environ.get('BIRDCAGE_OPERATOR_PASSWORD', 'Aviary-Default-1!'),
}
TOKEN = os.environ.get('BIRDCAGE_CONTROL_TOKEN', 'lab-aviary-door-token')
SECRET = os.environ.get('BIRDCAGE_SECRET_KEY', 'lab-aviary-secret').encode()
PORTS = {'video': 48215, 'admin': 48216, 'door': 52113}

lock = threading.Lock()
state = {'door': 'closed', 'bird': 'present', 'alarm': False, 'ts': int(time.time())}


def persist():
    os.makedirs(STATE_DIR, exist_ok=True)
    with open(STATE_FILE, 'w') as handle:
        json.dump(state, handle)


def sign(user):
    return user + ':' + hmac.new(SECRET, user.encode(), hashlib.sha256).hexdigest()


def verify(cookie):
    user, _, mac = (cookie or '').partition(':')
    return user if user in USERS and hmac.compare_digest(mac, sign(user).split(':', 1)[1]) else None


class Quiet(BaseHTTPRequestHandler):
    def log_message(self, *args):
        pass

    def reply(self, code, body, ctype='text/html', headers=()):
        data = body.encode() if isinstance(body, str) else body
        self.send_response(code)
        self.send_header('Content-Type', ctype)
        self.send_header('Content-Length', str(len(data)))
        for key, value in headers:
            self.send_header(key, value)
        self.end_headers()
        self.wfile.write(data)


class Video(Quiet):
    def do_GET(self):
        if self.path.startswith('/door'):
            with lock:
                return self.reply(200, json.dumps({k: state[k] for k in ('door', 'bird', 'alarm')}), 'application/json')
        self.reply(200, '<title>ACME Aviary</title><h1>Tweety Cam (stand-in)</h1>')


class Admin(Quiet):
    PAGE = ('<h2>Aviary Admin</h2><form method=post action=/admin/login>'
            '<input name=username><input name=password type=password><button>Sign in</button></form>')

    def do_GET(self):
        path = urlparse(self.path).path
        cookie = dict(p.strip().split('=', 1) for p in self.headers.get('Cookie', '').split(';') if '=' in p)
        user = verify(cookie.get('session'))
        if path == '/admin/login':
            return self.reply(200, self.PAGE)
        if path == '/admin' and user:
            return self.reply(200, f'<h2>Signed in as {user}</h2><a href=/admin/sysinfo>system info</a>')
        if path == '/admin/sysinfo' and user:
            return self.reply(200, f'<pre>host: {os.uname().nodename}\nuid: {os.getuid()}\ncwd: {os.getcwd()}</pre>')
        self.reply(302, '', headers=[('Location', '/admin/login')])

    def do_POST(self):
        length = int(self.headers.get('Content-Length', 0))
        form = parse_qs(self.rfile.read(length).decode())
        user = (form.get('username') or [''])[0]
        password = (form.get('password') or [''])[0]
        if user in USERS and hmac.compare_digest(USERS[user], password):
            return self.reply(302, '', headers=[('Location', '/admin'), ('Set-Cookie', 'session=' + sign(user))])
        self.reply(200, '<p>Invalid credentials</p>' + self.PAGE)


class Door(Quiet):
    def do_GET(self):
        if urlparse(self.path).path == '/nvr7/state':
            with lock:
                return self.reply(200, json.dumps(state), 'application/json')
        self.reply(404, '')

    def do_POST(self):
        parsed = urlparse(self.path)
        query = parse_qs(parsed.query)
        token = self.headers.get('X-Control-Token') or (query.get('token') or [''])[0]
        if parsed.path != '/nvr7/control' or not hmac.compare_digest(token, TOKEN):
            return self.reply(403, '')
        target = {'lock': 'closed', 'close': 'closed', 'unlock': 'open', 'open': 'open'}.get((query.get('door') or [''])[0])
        if not target:
            return self.reply(400, '{"error":"pass door=lock|unlock"}', 'application/json')
        with lock:
            state.update(door=target, ts=int(time.time()))
            persist()
            return self.reply(200, json.dumps(state), 'application/json')


def main():
    os.makedirs(STATE_DIR, exist_ok=True)
    persist()
    servers = [ThreadingHTTPServer(('0.0.0.0', PORTS[name]), handler)
               for name, handler in (('video', Video), ('admin', Admin), ('door', Door))]
    for server in servers[1:]:
        threading.Thread(target=server.serve_forever, daemon=True).start()
    servers[0].serve_forever()


main()
