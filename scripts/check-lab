#!/usr/bin/env python3
"""Opt-in live smoke suite through ccdcctl and its public reports. Lab only."""
import argparse
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import subprocess
import sys
import urllib.request

ROOT = Path(__file__).resolve().parents[1]
# Never inherit transport overrides that could accidentally select real hosts.
os.environ['ANSIBLE_ARGS'] = ''
loader = importlib.machinery.SourceFileLoader('ccdcctl_lab', str(ROOT / 'scripts/ccdcctl'))
spec = importlib.util.spec_from_loader(loader.name, loader)
ctl = importlib.util.module_from_spec(spec)
loader.exec_module(ctl)


def argument_parser():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--inventory', type=Path, default=ROOT / 'lab/inventory.yml',
                        help='lab connection inventory, including a lab outside this repository')
    parser.add_argument('--password-file', type=Path, help='optional disposable root password file')
    return parser


def main():
    args = argument_parser().parse_args()
    inventory = args.inventory.expanduser().resolve()
    os.environ['ANSIBLE_INVENTORY'] = str(inventory)
    checks = []
    hosts, variables = ctl.select()
    if hosts != ['hatchery', 'tarpit'] or any(variables[h]['ansible_host'] != '127.0.0.1' for h in hosts):
        raise RuntimeError('Not the generated two-host loopback lab inventory')

    def passed(label):
        print('PASS ' + label, flush=True)
        checks.append({'check': label, 'passed': True})

    def command(*args, expected=0):
        result = subprocess.run([sys.executable, str(ROOT / 'scripts/ccdcctl'), *args],
                                cwd=ROOT, capture_output=True, text=True, timeout=180)
        checks.append({'command': list(args), 'rc': result.returncode,
                       'stdout': result.stdout, 'stderr': result.stderr})
        if result.returncode != expected:
            raise RuntimeError('ccdcctl ' + ' '.join(args) + ': ' + result.stderr + result.stdout)
        return result.stdout

    secret = args.password_file or inventory.parent / 'secrets/root.password'
    if secret.exists():
        password = ctl.read_secret(secret)
        for host in hosts:
            success, _, error = ctl.probe_root(host, password)
            if not success:
                raise RuntimeError(host + ' root authentication: ' + error)
        passed('root password SSH authentication, both hosts')

    # Service metadata belongs to the fixture, not the SSH inventory.
    containers = dict(zip(hosts, json.loads(subprocess.check_output(
        ['docker', 'inspect', *('ccdc-lab-' + host for host in hosts)], text=True))))
    service_checks = {
        'hatchery': 'test "$(readlink /proc/1/exe)" = /bin/busybox; '
                    'for name in sshd nginx crond syslog ccdc-app ccdc-relay-ssh ccdc-relay-http ccdc-relay-app; '
                    'do rc-service "$name" status; done',
        'tarpit': 'test "$(cat /proc/1/comm)" = systemd; '
                  'for name in ssh nginx cron rsyslog dbus systemd-journald ccdc-app '
                  'ccdc-relay@ssh ccdc-relay@http ccdc-relay@app; '
                  'do systemctl is-active "$name"; done',
    }
    for host in hosts:
        subprocess.run(['docker', 'exec', 'ccdc-lab-' + host, 'sh', '-ec', service_checks[host]],
                       capture_output=True, text=True, timeout=30, check=True)
    passed('native PID 1 and managed SSH, nginx, cron, logging, app and relay services')

    for host, domain in (('hatchery', 'dl-cdn.alpinelinux.org'), ('tarpit', 'deb.debian.org')):
        subprocess.run(['docker', 'exec', 'ccdc-lab-' + host, 'python3', '-c',
                        'import socket, sys; assert socket.getaddrinfo(sys.argv[1], 443, type=socket.SOCK_STREAM)',
                        domain], capture_output=True, text=True, timeout=15, check=True)
    passed('external DNS resolution for both distribution package repositories')

    for host in hosts:
        for service in ('http', 'app'):
            port = int(containers[host]['Config']['Labels']['ccdc.lab.' + service + '_port'])
            with urllib.request.urlopen(f"http://127.0.0.1:{port}", timeout=5) as response:
                if response.status != 200 or host not in response.read().decode():
                    raise RuntimeError(host + ': HTTP fixture did not respond correctly')
    passed('nginx and fixture HTTP services visible on host loopback')
    peer = containers['tarpit']['NetworkSettings']['Networks']['ccdc-lab-internal']['IPAddress']
    result = subprocess.run(['docker', 'exec', 'ccdc-lab-hatchery', 'python3', '-c',
                             'import sys, urllib.request; print(urllib.request.urlopen(sys.argv[1], timeout=5).read().decode())',
                             f'http://{peer}:9000'], capture_output=True, text=True, timeout=10, check=True)
    if 'tarpit - disposable CCDC lab' not in result.stdout:
        raise RuntimeError('Containers cannot communicate over their private virtual network')
    passed('private bridge connectivity between hatchery and tarpit')

    for args in [('ping',), ('ssh', 'status'), ('firewall', 'status'), ('listeners',)]:
        command(*args)
        passed('ccdcctl ' + ' '.join(args) + ', both inventory hosts')

    for _ in range(2):
        command('integrity', expected=1)
        for host in hosts:
            state = json.loads((ROOT / 'reports' / host / 'integrity/report.json').read_text())
            if state.get('errors'):
                raise RuntimeError(host + ': integrity scan incomplete: ' + str(state['errors']))
            critical = {f.get('path') for f in state['findings'] if f['severity'] == 'critical'}
            if not {'/usr/bin/ssh', '/usr/bin/scp', '/etc/passwd'} <= critical:
                raise RuntimeError(host + ': failed to detect known package/permission faults')
    passed('package tampering/missing files and critical modes persist across scans')

    command('lse', expected=1)
    for host in hosts:
        state = json.loads((ROOT / 'reports' / host / 'lse/report.json').read_text())
        if state.get('errors') or state.get('incomplete_ids'):
            raise RuntimeError(host + ': LSE coverage incomplete')
        ids = {f['id'] for f in state['findings']}
        if not {'fst160', 'ret010'} <= ids:
            raise RuntimeError(host + ': failed to detect known LSE conditions')
        if 'sud000' in ids:
            raise RuntimeError(host + ': expected oski sudo was reported as a vulnerability')
    passed('LSE detects writable critical file and recurring task, without alerting on expected oski sudo')

    output = command('monitor', '--once', expected=1)
    for kind in ('SSH', 'FIREWALL', 'INTEGRITY', 'LSE'):
        if kind not in output:
            raise RuntimeError('Combined monitor did not include ' + kind)
    passed('combined monitor includes all four modules, without accepting baselines')
    ctl.save(ROOT / 'reports/lab/check.json', {'checks': checks})
    print('Live suite passed; evidence: reports/lab/check.json')


if __name__ == '__main__':
    try:
        main()
    except (OSError, RuntimeError, ValueError, KeyError, subprocess.SubprocessError) as exc:
        print('FAIL ' + ctl.terminal(exc), file=sys.stderr)
        sys.exit(1)
